{
  "name": "satzmodelle-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "demo-zip": "python3 -I ../tools/make_demo_library.py ../demo-library --zip ../demo-library.zip",
